# ---- Frontend (Vite) ----
VITE_SUPABASE_URL=https://kmlheefyzhhegxmtaovq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_9R9LMwYGu14evgtEJd4J3Q_CHhDbQsI
# Local dev only: point the SPA at the uvicorn backend. Leave unset in production (same-origin /api).
VITE_API_URL=http://localhost:8000/api
# Error reporting. Leave unset locally — no DSN means the Sentry SDK is never
# initialised, which is how dev, vitest and CI stay out of the issue stream.
# Production's value is committed in .env.production (a browser DSN is public).
# VITE_SENTRY_DSN=

# ---- Backend (FastAPI) ----
ENV=development
# Supabase Transaction Pooler (port 6543!) with asyncpg driver:
DATABASE_URL=postgresql+asyncpg://postgres.kmlheefyzhhegxmtaovq:YOUR_DB_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://kmlheefyzhhegxmtaovq.supabase.co
# Legacy JWT secret (Dashboard -> Project Settings -> API -> JWT Secret).
# Only needed if your project signs tokens with HS256 (legacy). With the newer
# asymmetric signing keys, the backend verifies against the JWKS endpoint instead.
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
# Required in production for GET /api/health/db (the DB latency probe opens a
# fresh pooler connection per call; without this key the probe returns 503).
HEALTH_PROBE_KEY=GENERATE_A_RANDOM_STRING
# Error reporting for the API function. Unlike the browser DSN this one is not
# public — it is the API's own project — so it lives in Vercel's env, not here.
# Unset locally, so a uvicorn run never reports.
# SENTRY_DSN=

# ---- Build-time only (Vercel Production env), never needed to run the app ----
# Uploads source maps so frontend stack traces are readable instead of minified.
# Without it `npm run build` skips generating maps entirely (vite.config.ts).
# Scope: "Source Map Upload" (project:releases) on the split-dec Sentry org.
# SENTRY_AUTH_TOKEN=
