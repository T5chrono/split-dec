# Package lifecycle scripts do not run on an install here.
#
# `vercel.json` and the `frontend`/`audit` CI jobs already pass
# `--ignore-scripts` explicitly, so the two machines that build what users are
# served were covered; a developer's own `npm install` was not, and that is the
# machine holding the Supabase service key, the Vercel token and the git
# credential. An install script is arbitrary code from ~600 packages, run for
# no reason but their being in the tree.
#
# Nothing is lost. Only two packages in this tree declare one: `@sentry/cli`,
# whose postinstall exits immediately because all eight `@sentry/cli-*`
# platform binaries are in the lockfile (the download is its fallback for
# `--no-optional` installs), and `fsevents`, which is darwin-only.
#
# This does not touch `npm run` — `build`, `test` and the rest still execute.
# It suppresses the `pre`/`post` hooks around them, of which this package has
# none. If a dependency ever genuinely needs its install script, run that one
# install with `--foreground-scripts --ignore-scripts=false` rather than
# deleting this file.
ignore-scripts=true
